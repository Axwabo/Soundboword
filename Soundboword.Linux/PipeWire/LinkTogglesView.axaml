<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Soundboword.Controls;assembly=Soundboword"
             xmlns:pipeWire="clr-namespace:Soundboword.Linux.PipeWire"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Soundboword.Linux.PipeWire.LinkTogglesView"
             x:DataType="pipeWire:LinkTogglesViewModel">
    <StackPanel>
        <controls:DataToggle Text="🔊 -&gt; 🎧" ToolTip.Tip="Hear Sounds (Sounds to Output Device)" />
        <controls:DataToggle Text="🔊 -&gt; 📣" ToolTip.Tip="Sounds to Virtual Microphone" />
        <controls:DataToggle Text="🎤 -&gt; 📣" ToolTip.Tip="Physical Mic to Virtual Microphone" />
        <controls:DataToggle Text="🎤 -&gt; 🎧" ToolTip.Tip="Hear Myself (Microphone to Output Device)" />
    </StackPanel>
</UserControl>
