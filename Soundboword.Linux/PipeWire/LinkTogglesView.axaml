<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pipeWire="clr-namespace:Soundboword.Linux.PipeWire"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Soundboword.Linux.PipeWire.LinkTogglesView"
             x:DataType="pipeWire:LinkTogglesViewModel">
    <StackPanel IsEnabled="{Binding !SwitchHandler.IsSwitching}" Spacing="0">
        <pipeWire:NodeLinkToggle DataContext="{Binding Manager.HearSounds}" Text="🔊 -&gt; 🎧" ToolTip.Tip="Hear Sounds (Sounds to Output Device)" />
        <pipeWire:NodeLinkToggle DataContext="{Binding Manager.MicSounds}" Text="🔊 -&gt; 📣" ToolTip.Tip="Mic Sounds (Sounds to Virtual Microphone)" />
        <pipeWire:NodeLinkToggle DataContext="{Binding Manager.MicPassthrough}" Text="🎤 -&gt; 📣" ToolTip.Tip="Mic Passthrough (Physical Microphone to Virtual Microphone)" />
        <pipeWire:NodeLinkToggle DataContext="{Binding Manager.HearMyself}" Text="🎤 -&gt; 🎧" ToolTip.Tip="Hear Myself (Physical Microphone to Output Device)" />
    </StackPanel>
</UserControl>
