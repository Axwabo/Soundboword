<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wizard="clr-namespace:Soundboword.Linux.PipeWire.Wizard"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="300"
        x:Class="Soundboword.Linux.PipeWire.Wizard.PipeWireWizardWindow"
        x:DataType="wizard:PipeWireWizardWindowViewModel"
        Icon="Assets/PipeWire.png"
        Title="PipeWire Wizard"
        Width="600" Height="300"
        Padding="5">
    <Design.DataContext>
        <wizard:PipeWireWizardWindowViewModel />
    </Design.DataContext>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
        <Label HorizontalAlignment="Center">The wizard will:</Label>
        <StackPanel HorizontalAlignment="Center">
            <Label>1. Stop all sounds</Label>
            <StackPanel Orientation="Horizontal">
                <Label>2. Create</Label>
                <Label FontWeight="SemiBold" Content="{Binding TargetDirectory}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label>3. Write</Label>
                <Label FontWeight="SemiBold" Content="{x:Static wizard:PipeWireWizardWindowViewModel.FileName}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label>4. Run</Label>
                <Label FontWeight="SemiBold">systemctl --user restart pipewire pipewire-pulse wireplumber</Label>
            </StackPanel>
        </StackPanel>
        <TextBlock Foreground="Yellow" TextWrapping="Wrap" Text="Note:&#10;Some applications might need a restart for audio to work properly" />
        <Button Command="{Binding RunCommand}" HorizontalAlignment="Center" HotKey="Enter">Run</Button>
    </StackPanel>
</Window>
