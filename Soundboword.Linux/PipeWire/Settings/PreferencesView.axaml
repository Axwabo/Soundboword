<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settings="clr-namespace:Soundboword.Linux.PipeWire.Settings"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Soundboword.Linux.PipeWire.Settings.PreferencesView"
             x:DataType="settings:PipeWirePreferences">
    <StackPanel>
        <!-- ReSharper disable once Xaml.StyleClassNotFound -->
        <Label Classes="title">PipeWire</Label>
        <TextBlock Foreground="Yellow" FontWeight="SemiBold">These settings are applied when Soundboword starts up</TextBlock>
        <CheckBox IsChecked="{Binding AutoMicSounds}">Auto-connect Sounds to Virtual Mic</CheckBox>
        <CheckBox IsChecked="{Binding AutoPassthrough}">Auto-connect Physical Microphone to Virtual Mic</CheckBox>
    </StackPanel>
</UserControl>
