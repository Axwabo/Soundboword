<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Soundboword.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:logging="clr-namespace:Soundboword.Logging"
        xmlns:controls="clr-namespace:Soundboword.Controls"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450"
        x:Class="Soundboword.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Soundboword">
    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>
    <Window.Resources>
        <x:Double x:Key="TabItemHeaderFontSize">18</x:Double>
    </Window.Resources>
    <Grid RowDefinitions="*,Auto">
        <Panel>
            <Grid ColumnDefinitions="Auto,*">
                <Grid.RowDefinitions>
                    <RowDefinition Height="8*" />
                    <RowDefinition Height="{Binding TogglesRowHeight, FallbackValue=*}" MinHeight="{Binding TogglesRowMinHeight, FallbackValue=160}" />
                </Grid.RowDefinitions>
                <TabStrip ItemsSource="{Binding Pages}" SelectedItem="{Binding CurrentPage}">
                    <TabStrip.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </TabStrip.ItemsPanel>
                    <TabStrip.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="30,Auto">
                                <Label Content="{Binding Icon}" HorizontalContentAlignment="Center" />
                                <Label Grid.Column="1" Content="{Binding Header}" VerticalContentAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </TabStrip.ItemTemplate>
                </TabStrip>
                <UserControl Grid.Row="1" Grid.Column="0" IsVisible="{Binding Toggles}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="5" Content="{Binding Toggles}" />
                <ItemsControl Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" ItemsSource="{Binding Pages}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Panel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:LazyControl Padding="5" Page="{Binding}" ActiveObject="{Binding Parent.CurrentPage}" IsLazy="{Binding Tab.IsLazy}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
            <Panel Background="#44000000" IsVisible="{Binding FilePicker.IsBrowsing}">
                <Label HorizontalAlignment="Center" VerticalAlignment="Center">Waiting for file dialog...</Label>
            </Panel>
        </Panel>
        <Panel Grid.Row="1" IsVisible="{Binding ShowBottomBar}">
            <logging:LogView DataContext="{Binding LogList.Last}" PointerPressed="NavigateToLogs" />
            <Button Command="{Binding LogList.ClearLastCommand}" Background="Transparent"
                    HorizontalAlignment="Right" VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                    Padding="3,0" CornerRadius="0">
                ×
            </Button>
        </Panel>
    </Grid>
</Window>
