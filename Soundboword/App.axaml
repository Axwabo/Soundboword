<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Soundboword.App"
             xmlns:converters="clr-namespace:Soundboword.Converters"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Rectangle.loading">
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="QuadraticEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Fill" Value="#555" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Fill" Value="#444" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Label.title">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="StackPanel">
            <Setter Property="Spacing" Value="5" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <converters:AudioOnlyStreamConverter x:Key="AudioOnlyStream" />
        <converters:LogLevelConverter x:Key="LogLevel" />
        <converters:TriggerModeConverter x:Key="PlaybackMode" />
        <converters:SoundStateConverter x:Key="SoundState" />
        <converters:BoolBrushConverter x:Key="ShortcutBackground" True="#22ffaa00" False="#2233ff00" />

        <SolidColorBrush x:Key="Playing" Color="#1100ff00" />
        <SolidColorBrush x:Key="Paused" Color="#11ffff00" />
        <SolidColorBrush x:Key="Error" Color="#11ff0000" />

        <SolidColorBrush x:Key="SidePanelBackground" Color="#33333333" />
        <SolidColorBrush x:Key="SidePanelPlaceholder" Color="#ccc" />
    </Application.Resources>
</Application>
