<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:logging="clr-namespace:Soundboword.Logging"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Soundboword.Logging.LogView"
             x:DataType="logging:LogViewModel">
    <Design.DataContext>
        <logging:LogViewModel Name="Among" Level="Error" Content="Us in real life" />
    </Design.DataContext>
    <TextBlock Padding="2" Background="{Binding Level, Converter={StaticResource LogLevel}}">
        <TextBlock.Text>
            <MultiBinding StringFormat="[{0}] {1}">
                <Binding Path="Name" />
                <Binding Path="Content" />
            </MultiBinding>
        </TextBlock.Text>
    </TextBlock>
</UserControl>
