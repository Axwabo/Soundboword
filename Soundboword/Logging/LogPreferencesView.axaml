<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:logging="clr-namespace:Soundboword.Logging"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Soundboword.Logging.LogPreferencesView"
             x:DataType="logging:LogPreferences">
    <Design.DataContext>
        <logging:LogPreferences />
    </Design.DataContext>
    <StackPanel>
        <Label Classes="title">Logging</Label>
        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,120" RowSpacing="5" ColumnSpacing="5">
            <Label VerticalAlignment="Center">In-app log level:</Label>
            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{x:Static logging:LogLevelExtensions.Levels}" SelectedItem="{Binding AppLevel}" HorizontalAlignment="Stretch" />
            <Label Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">File log level:</Label>
            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Static logging:LogLevelExtensions.Levels}" SelectedItem="{Binding FileLevel}" HorizontalAlignment="Stretch" />
        </Grid>
        <Label IsVisible="False" Foreground="Yellow" FontWeight="SemiBold" Name="Note">Changes will apply after you restart Soundboword</Label>
        <CheckBox IsChecked="{Binding HideBottomBar}">Always hide bottom bar</CheckBox>
    </StackPanel>
</UserControl>
