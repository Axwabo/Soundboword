<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settings="clr-namespace:Soundboword.Settings"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Soundboword.Settings.SettingsManagerView"
             x:DataType="settings:SettingsManager"
             Name="Root">
    <Design.DataContext>
        <settings:SettingsManager />
    </Design.DataContext>
    <UserControl.Styles>
        <!--<Style Selector="ItemsControl ContentPresenter:nth-last-child(1)">
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>-->
    </UserControl.Styles>
    <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Sections}" Loaded="Control_OnLoaded">
            <ItemsControl.Styles>
                <Style Selector=":is(Panel) > ContentPresenter" x:DataType="settings:SettingsSection">
                    <Setter Property="IsVisible" Value="False"></Setter>
                    <Setter Property="BorderBrush" Value="Gray" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="Padding" Value="0,0,0,10" />
                    <Setter Property="Margin" Value="0,0,0,10" />
                </Style>
            </ItemsControl.Styles>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
