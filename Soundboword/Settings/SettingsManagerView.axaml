<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settings="clr-namespace:Soundboword.Settings"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Soundboword.Settings.SettingsManagerView"
             x:DataType="settings:SettingsManager"
             Name="Root">
    <Design.DataContext>
        <settings:SettingsManager />
    </Design.DataContext>
    <UserControl.Styles>
        <Style Selector="Rectangle.section-separator:nth-last-child(1)">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </UserControl.Styles>
    <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Sections}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="10">
                        <Label Padding="0" FontSize="24" Content="{Binding Title}" FontWeight="Bold" />
                        <UserControl Content="{Binding}" />
                        <Rectangle Classes="section-separator" HorizontalAlignment="Stretch" Height="1" Fill="Gray" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
