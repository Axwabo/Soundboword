<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settings="clr-namespace:Soundboword.Settings"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Soundboword.Settings.SettingsManagerView"
             x:DataType="settings:SettingsManager"
             Name="Root">
    <Design.DataContext>
        <settings:SettingsManager />
    </Design.DataContext>
    <UserControl.Styles>
        <Style Selector="ItemsControl :nth-last-child(1) Rectangle.section-separator">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </UserControl.Styles>
    <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Sections}" />
    </ScrollViewer>
</UserControl>
